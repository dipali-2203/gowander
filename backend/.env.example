ROUTING_PROVIDER=haversine
# Optional category relevance base scores (0–1). These are planning heuristics,
# not popularity, ratings, or measured visitor demand.
# GOWANDER_PRIORITY_HISTORICAL=0.86
# GOWANDER_PRIORITY_MUSEUM=0.88
# GOWANDER_PRIORITY_CULTURAL=0.76
# GOWANDER_PRIORITY_VIEWPOINT=0.70
# GOWANDER_PRIORITY_ENTERTAINMENT=0.66
# GOWANDER_PRIORITY_RELIGIOUS=0.50
# GOWANDER_PRIORITY_PARK=0.58
# GOWANDER_PRIORITY_OTHER=0.44
# Itinerary-only OSM duplicate filtering thresholds (meters / similarity 0..1).
ITINERARY_DUPLICATE_EXACT_DISTANCE_METERS=125
ITINERARY_DUPLICATE_SIMILAR_DISTANCE_METERS=75
ITINERARY_DUPLICATE_NAME_SIMILARITY=0.86
DATABASE_URL=sqlite:///./trip_optimizer.db
# Hotel recommendations: positive weights are normalized across available factors.
HOTEL_RECOMMENDATION_WEIGHT_PROXIMITY=0.50
HOTEL_RECOMMENDATION_WEIGHT_PRICE=0.25
HOTEL_RECOMMENDATION_WEIGHT_QUALITY=0.15
HOTEL_RECOMMENDATION_WEIGHT_PREFERENCE=0.07
HOTEL_RECOMMENDATION_WEIGHT_AMENITIES=0.03
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRIP_SHARE_SECRET=
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
# Open-Meteo Forecast API. The public endpoint is for non-commercial use;
# configure the customer endpoint and key when using an applicable paid plan.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_API_KEY=
WEATHER_RAIN_PROBABILITY_THRESHOLD=60
WEATHER_RAIN_MM_THRESHOLD=2.5
WEATHER_HEAT_C_THRESHOLD=38
WEATHER_COLD_C_THRESHOLD=5
WEATHER_WIND_KMH_THRESHOLD=50
WEATHER_REPLAN_RISK_THRESHOLD=0.65
# OSM attraction catalogs are fetched only by the explicit CLI/admin refresh, never on planner reads.
POI_INGESTION_ENABLED=false
POI_ALLOW_SYNTHETIC_FALLBACK=true
OSM_OVERPASS_URL=https://overpass.private.coffee/api/interpreter
OSM_USER_AGENT=GoWander-POI-Ingestion/1.0 (set a project contact before production)
# Create a Google OAuth web client and add this exact callback URI there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Configure an SMTP relay to enable password reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
# Keep strict for same-site frontend/API deployments. Use none only for a
# cross-site deployment with HTTPS; Origin validation remains required.
AUTH_COOKIE_SAMESITE=strict
# Leave unset locally (localhost cookies are HTTP); set true in production.
# AUTH_COOKIE_SECURE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
