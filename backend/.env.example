ROUTING_PROVIDER=haversine
DATABASE_URL=sqlite:///./trip_optimizer.db
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
# Create a Google OAuth web client and add this exact callback URI there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Configure an SMTP relay to enable password reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
# Keep strict for same-site frontend/API deployments. Use none only for a
# cross-site deployment with HTTPS; Origin validation remains required.
AUTH_COOKIE_SAMESITE=strict
# Leave unset locally (localhost cookies are HTTP); set true in production.
# AUTH_COOKIE_SECURE=true
